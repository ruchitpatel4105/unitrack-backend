# Uni-Track Environment Configuration

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=unitrack_super_secret_jwt_key_2026_production

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
